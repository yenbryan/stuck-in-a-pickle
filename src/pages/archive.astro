---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import StoryCard from '../components/StoryCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { STORY_CATEGORIES } from '../types/story';
import { categorySlug, formatMonth, getAllStories } from '../utils/stories';

const stories = await getAllStories();

const grouped = stories.reduce<Record<string, typeof stories>>((groups, story) => {
  const key = formatMonth(story.publishedAt);
  (groups[key] ??= []).push(story);
  return groups;
}, {});

const monthId = (month: string) => month.toLowerCase().replaceAll(' ', '-');
---

<BaseLayout
  title="Archive — Stuck in a Pickle"
  description="Every Stuck in a Pickle comic, arranged for efficient procrastination."
  canonicalPath="/archive"
  image="/og.png"
>
  <SiteHeader />

  <main id="main-content" class="shell archive">
    <header class="archive__intro">
      <p class="label">The complete archive</p>
      <h1 class="headline">Every pickle, in order.</h1>
      <p class="lede">
        {stories.length} comics so far. Browse by date below, or by the particular system
        you suspect is functioning as intended.
      </p>
    </header>

    <nav class="archive__topics" aria-label="Browse by category">
      <p class="label">By predicament</p>
      <ul>
        {STORY_CATEGORIES.map((category) => (
          <li><a href={`/category/${categorySlug(category)}`}>{category}</a></li>
        ))}
      </ul>
    </nav>

    {Object.entries(grouped).map(([month, monthStories]) => (
      <section class="archive__month" id={monthId(month)} aria-labelledby={`${monthId(month)}-heading`}>
        <div class="section-head">
          <h2 class="label" id={`${monthId(month)}-heading`}>{month}</h2>
          <p class="section-head__aside">
            {monthStories.length} {monthStories.length === 1 ? 'comic' : 'comics'}
          </p>
        </div>
        <div class="archive__grid">
          {monthStories.map((story) => <StoryCard story={story} variant="related" />)}
        </div>
      </section>
    ))}
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .archive {
    padding-block: clamp(2rem, 4vw, 3rem) 0;
  }

  .archive__intro {
    max-width: 42rem;
  }

  .archive__intro .headline {
    margin: 0.5rem 0 0.9rem;
  }

  .archive__topics {
    display: flex;
    align-items: baseline;
    gap: 1rem clamp(2rem, 5vw, 3.5rem);
    margin-top: var(--s-12);
    padding-block: var(--s-4);
    border-block: 1px solid var(--hair);
  }

  .archive__topics ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .archive__topics a {
    display: inline-block;
    padding-block: 0.25rem;
    font-family: var(--font-display);
    font-variation-settings: "opsz" 24, "wght" 600, "SOFT" 22, "WONK" 0;
    font-size: 1.1rem;
  }

  .archive__month {
    padding-top: var(--s-18);
    scroll-margin-top: 1rem;
  }

  .archive__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.75rem, 3vw, 2.5rem);
    align-items: start;
  }

  @media (max-width: 60rem) {
    .archive__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 46rem) {
    .archive__topics {
      flex-direction: column;
      gap: 0.6rem;
    }
  }

  @media (max-width: 34rem) {
    .archive__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
