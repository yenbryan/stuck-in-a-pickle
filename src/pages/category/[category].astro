---
import NewsletterBox from '../../components/NewsletterBox.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import StoryCard from '../../components/StoryCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { STORY_CATEGORIES, type StoryCategory } from '../../types/story';
import { categorySlug, getAllStories } from '../../utils/stories';

export function getStaticPaths() {
  return STORY_CATEGORIES.map((category) => ({
    params: { category: categorySlug(category) },
    props: { category },
  }));
}

interface Props {
  category: StoryCategory;
}

const { category } = Astro.props;
const allStories = await getAllStories();
const stories = allStories.filter((story) => story.category === category);

const descriptions: Record<StoryCategory, string> = {
  AI: 'Machines doing an unsettlingly accurate impression of management.',
  Technology: 'New solutions, complete with newer and more interesting problems.',
  Politics: 'Public systems functioning with breathtaking commitment to the bit.',
  Business: 'Organizations discovering fresh shapes for the spreadsheet.',
  Work: 'Where productivity goes to update its status.',
  Internet: 'Everyone is typing. Nobody is okay.',
  Life: 'Ordinary existence, now available as a subscription.',
  Science: 'The universe submits another confusing progress report.',
  Humanity: 'A long-running public beta with no rollback plan.',
};
---

<BaseLayout
  title={`${category} comics — Stuck in a Pickle`}
  description={descriptions[category]}
  canonicalPath={`/category/${categorySlug(category)}`}
  image="/og.png"
>
  <SiteHeader />

  <main id="main-content" class="shell category">
    <header class="category__intro">
      <p class="label">Topic</p>
      <h1 class="headline">{category}</h1>
      <p class="lede">{descriptions[category]}</p>
      <p class="meta category__count">
        {stories.length} {stories.length === 1 ? 'comic' : 'comics'} currently in the jar
      </p>
    </header>

    {stories.length > 0 ? (
      <div class="category__grid">
        {stories.map((story) => <StoryCard story={story} variant="feed" headingLevel={2} />)}
      </div>
    ) : (
      <div class="category__empty">
        <img src="/images/pickle-jar-character.webp" width="300" height="300" alt="" loading="lazy" decoding="async" />
        <p>Nothing here yet. Humanity must be taking the afternoon off.</p>
        <a class="button" href="/archive">Browse the whole archive</a>
      </div>
    )}

    <NewsletterBox />
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .category {
    padding-block: clamp(2rem, 4vw, 3rem) 0;
  }

  .category__intro {
    max-width: 42rem;
    padding-bottom: var(--s-6);
    border-bottom: 2px solid var(--ink);
  }

  .category__intro .headline {
    margin: 0.5rem 0 0.75rem;
  }

  .category__count {
    margin-top: 0.9rem;
  }

  .category__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.25rem, 4vw, 3rem);
    margin-top: var(--s-12);
    align-items: start;
  }

  /* One of the places the mascot earns its keep. */
  .category__empty {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding-block: var(--s-18);
    text-align: center;
  }

  .category__empty img {
    width: 8rem;
    height: auto;
    opacity: 0.9;
  }

  .category__empty p {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 36, "wght" 600, "SOFT" 24, "WONK" 1;
    font-size: 1.35rem;
  }

  @media (max-width: 46rem) {
    .category__grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }
</style>
