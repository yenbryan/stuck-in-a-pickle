---
import ComicStage from '../components/ComicStage.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import StoryBrief from '../components/StoryBrief.astro';
import StoryCard from '../components/StoryCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { STORY_CATEGORIES } from '../types/story';
import { categorySlug, formatStoryDate, getAllStories, getFeaturedStory } from '../utils/stories';

const stories = await getAllStories();
const featured = await getFeaturedStory();

const rest = stories.filter((story) => story.slug !== featured.slug);
const recent = rest.slice(0, 4);
// One second feature, then a row of three. The row's baselines go ragged on
// their own because each comic keeps its true aspect ratio.
const [lead, ...trio] = recent;
const evergreen = rest
  .filter((story) => story.evergreen && !recent.some((item) => item.slug === story.slug))
  .slice(0, 3);
---

<BaseLayout image="/og.png">
  <SiteHeader />

  <main id="main-content">
    <div class="shell">
      <article class="hero">
        <p class="hero__flag">
          <span class="label label--flag">Today&rsquo;s pickle</span>
          <span class="hero__dot" aria-hidden="true"></span>
          <a class="hero__category" href={`/category/${categorySlug(featured.category)}`}>{featured.category}</a>
          <span class="hero__dot" aria-hidden="true"></span>
          <time class="meta" datetime={featured.publishedAt.toISOString()}>{formatStoryDate(featured.publishedAt)}</time>
        </p>

        <h1 class="headline">
          <a href={`/comic/${featured.slug}`}>{featured.title}</a>
        </h1>

        <StoryBrief story={featured} layout="split" idPrefix="hero" />

        <div class="hero__stage">
          <ComicStage story={featured} priority />
        </div>

        <p class="hero__source">
          {featured.fictional ? (
            <span>Fictional demonstration story.</span>
          ) : (
            <span>Based on reporting from <a href={featured.sourceUrl} rel="external noreferrer">{featured.sourceName}</a>.</span>
          )}
          <a class="hero__more microlink" href={`/comic/${featured.slug}`}>Read the story <span aria-hidden="true">&rarr;</span></a>
        </p>
      </article>

      <section class="feed-section" aria-labelledby="feed-title">
        <div class="section-head">
          <h2 class="label" id="feed-title">The rest of the jar</h2>
          <a class="section-head__aside" href="/archive">All {stories.length} comics <span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="feed">
          <StoryCard story={lead} variant="lead" />
          <div class="feed__trio">
            {trio.map((story) => <StoryCard story={story} variant="feed" />)}
          </div>
        </div>
      </section>
    </div>

    <div class="band">
      <div class="shell">
        <section aria-labelledby="evergreen-title">
          <div class="section-head">
            <h2 class="label" id="evergreen-title">Previously in civilization</h2>
            <p class="section-head__aside">Still unfortunately relevant</p>
          </div>
          <div class="evergreen">
            {evergreen.map((story) => <StoryCard story={story} variant="related" showDate={false} />)}
          </div>
        </section>

        <div class="dice">
          <p class="dice__lead">{stories.length} comics in the jar, and no wrong order to read them in.</p>
          <a class="button" href="/random">Give me a random one</a>
        </div>

        <nav class="topics" id="topics" aria-labelledby="topics-title">
          <h2 class="label" id="topics-title">By predicament</h2>
          <ul class="topics__list">
            {STORY_CATEGORIES.map((category) => (
              <li><a href={`/category/${categorySlug(category)}`}>{category}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    <div class="shell">
      <NewsletterBox />
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2rem, 4vw, 3rem) 0;
  }

  .hero__flag {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.8rem;
    margin-bottom: 0.9rem;
  }

  .hero__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--hair-strong);
  }

  .hero__category {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    color: var(--pickle);
    text-decoration: none;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.145em;
    text-transform: uppercase;
  }

  .hero__category:hover {
    color: var(--pickle-deep);
    text-decoration: underline;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.28em;
  }

  /* The headline runs the full measure rather than sitting in a column with a
     hole beside it. Two or three lines, then the art. */
  .hero .headline {
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
  }

  .hero .headline a {
    text-decoration: none;
  }

  .hero .headline a:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.05em;
    text-underline-offset: 0.1em;
  }

  .hero__stage {
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .hero__source {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin-top: 0.75rem;
    color: var(--ink-soft);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .hero__more {
    margin-left: auto;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pickle-deep);
  }

  .feed-section {
    padding-block: var(--s-28) 0;
  }

  .feed {
    display: grid;
    gap: var(--s-18);
  }

  .feed__trio {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2rem);
    align-items: start;
  }

  .band {
    margin-top: var(--s-28);
  }

  .evergreen {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  .dice {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: var(--s-12);
    padding-top: var(--s-6);
    border-top: 1px solid var(--hair);
  }

  .dice__lead {
    max-width: 32ch;
    font-family: var(--font-display);
    font-variation-settings: "opsz" 36, "wght" 600, "SOFT" 24, "WONK" 1;
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.45rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .topics {
    display: flex;
    align-items: baseline;
    gap: 1rem clamp(2rem, 5vw, 3.5rem);
    margin-top: var(--s-8);
    padding-top: var(--s-6);
    border-top: 1px solid var(--hair);
    scroll-margin-top: 1rem;
  }

  .topics__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topics__list a {
    display: inline-block;
    padding-block: 0.25rem;
    font-family: var(--font-display);
    font-variation-settings: "opsz" 24, "wght" 600, "SOFT" 22, "WONK" 0;
    font-size: 1.15rem;
  }

  @media (max-width: 61rem) {
    .feed__trio,
    .evergreen {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 46rem) {
    .feed {
      gap: var(--s-12);
    }

    .feed__trio,
    .evergreen {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .hero__source {
      gap: 0.75rem;
    }

    .hero__more {
      margin-left: 0;
    }

    .topics {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
