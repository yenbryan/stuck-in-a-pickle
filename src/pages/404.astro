---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Stuck in a Pickle" description="This pickle appears to have rolled under the refrigerator." noindex>
  <SiteHeader />
  <main id="main-content" class="shell not-found">
    <img src="/images/pickle-jar-character.webp" width="300" height="300" alt="" decoding="async" />
    <p class="label">Error 404</p>
    <h1 class="headline">This pickle rolled under the refrigerator.</h1>
    <p class="not-found__line">We could retrieve it, but then we would have to move the refrigerator.</p>
    <div class="not-found__actions">
      <a class="button" href="/">Read the latest comic</a>
      <a class="button button--quiet" href="/random">Random pickle</a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .not-found { display: grid; justify-items: center; min-height: 55vh; padding-block: var(--s-18); text-align: center; align-content: center; }
  .not-found img { width: min(8rem, 34vw); height: auto; margin-bottom: 1.25rem; }
  .not-found .headline { max-width: 20ch; margin: 0.6rem 0 0.9rem; }
  .not-found__line { max-width: 42ch; color: var(--ink-soft); font-size: 1rem; }
  .not-found__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 1.75rem; }
</style>
