---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllStories } from '../utils/stories';
const stories = await getAllStories();
const paths = stories.map((story) => `/comic/${story.slug}`);
---

<BaseLayout title="Random comic — Stuck in a Pickle" description="Let the jar decide which comic you read next." canonicalPath="/random" noindex>
  <SiteHeader />
  <main id="main-content" class="shell random-page">
    <img src="/images/pickle-jar-character.webp" width="480" height="480" alt="" decoding="async" /><p class="label">Reaching into the jar</p><h1 class="headline">Choosing a random pickle&hellip;</h1><p>If nothing happens, your browser may be sensibly suspicious of whimsy.</p>
    <noscript><p>JavaScript is off, so the universe has selected <a href={`/comic/${stories[0].slug}`}>{stories[0].title}</a>.</p></noscript>
  </main>
  <SiteFooter />
  <script is:inline define:vars={{ paths }}>const destination = paths[Math.floor(Math.random() * paths.length)]; window.location.replace(destination);</script>
</BaseLayout>

<style>
  .random-page { display: grid; min-height: 55vh; padding-block: 5rem; place-items: center; align-content: center; text-align: center; }
  img { width: min(9rem, 42vw); height: auto; margin-bottom: 1.25rem; }
    .random-page > p:last-of-type { max-width: 34rem; margin-top: 0.75rem; color: var(--ink-soft); font-size: 0.9375rem; }
  .label { margin-bottom: 0.5rem; }
</style>
