---
import Wordmark from './Wordmark.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-row">
    <div class="footer-brand">
      <Wordmark variant="stacked" />
      <p>Made by humans using an irresponsible number of computers.</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <a class="microlink" href="/about">About</a>
      <a class="microlink" href="/archive">Archive</a>
      <a class="microlink" href="/#topics">Topics</a>
      <a class="microlink" href="/random">Random</a>
      <a class="microlink" href="/rss.xml">RSS</a>
    </nav>

    <p class="footer-fine">
      &copy; {year} Stuck in a Pickle.<br />
      Please recycle this internet.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--s-12);
    padding-block: var(--s-8);
    border-top: 1px solid var(--hair-strong);
  }

  .footer-row {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) auto;
    align-items: start;
    gap: 2rem;
  }

  .footer-brand p {
    max-width: 34ch;
    margin-top: 0.6rem;
    color: var(--ink-faint);
    font-size: 0.8125rem;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
  }

  .footer-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-fine {
    color: var(--ink-faint);
    font-size: 0.78rem;
    line-height: 1.55;
    text-align: right;
  }

  @media (max-width: 60rem) {
    .footer-row {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .footer-fine {
      text-align: left;
    }
  }
</style>
