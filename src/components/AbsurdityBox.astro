---
interface Props { absurdity: string; }
const { absurdity } = Astro.props;
---

<section class="absurdity" aria-labelledby="why-ridiculous"><p class="eyebrow" id="why-ridiculous">Why this is ridiculous</p><p>{absurdity}</p></section>

<style>.absurdity { padding: clamp(1.25rem, 3vw, 2rem); background: var(--pickle-pale); } p:last-child { margin: 0; font-family: var(--serif); font-size: clamp(1.1rem, 2.3vw, 1.45rem); font-weight: 700; line-height: 1.42; }</style>
