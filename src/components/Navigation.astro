---
const currentPath = Astro.url.pathname;
const links = [
  ['Latest', '/'], ['AI', '/category/ai'], ['Tech', '/category/technology'], ['Politics', '/category/politics'],
  ['Business', '/category/business'], ['Life', '/category/life'], ['Archive', '/archive'], ['↝ Random', '/random'], ['About', '/about'],
];
const isCurrent = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<nav class="navigation desktop-nav" aria-label="Primary navigation">
  {links.map(([label, href]) => <a class:list={{ random: label.includes('Random') }} aria-current={isCurrent(href) ? 'page' : undefined} href={href}>{label}</a>)}
</nav>

<details class="mobile-nav">
  <summary>Browse the paper <span aria-hidden="true">☰</span></summary>
  <nav aria-label="Primary mobile navigation">
    {links.map(([label, href]) => <a class:list={{ random: label.includes('Random') }} aria-current={isCurrent(href) ? 'page' : undefined} href={href}>{label}</a>)}
  </nav>
</details>

<style>
  .navigation { display: flex; justify-content: center; gap: clamp(0.8rem, 2.3vw, 2rem); overflow-x: auto; padding: 0.7rem 0.25rem 0.8rem; border-block: 3px double var(--ink); scrollbar-width: none; }
  .navigation::-webkit-scrollbar { display: none; }
  a { flex: 0 0 auto; font-size: 0.73rem; font-weight: 800; letter-spacing: 0.07em; text-decoration: none; text-transform: uppercase; }
  a:hover, a[aria-current='page'] { color: var(--pickle-dark); text-decoration: underline 2px; text-underline-offset: 0.35rem; }
  .random { color: var(--tomato); }
  .mobile-nav { display: none; border-block: 3px double var(--ink); text-align: left; }
  summary { display: flex; justify-content: space-between; padding: 0.72rem 0.2rem; cursor: pointer; font-size: 0.74rem; font-weight: 850; letter-spacing: 0.09em; list-style: none; text-transform: uppercase; }
  summary::-webkit-details-marker { display: none; }
  .mobile-nav nav { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; padding-bottom: 0.55rem; }
  .mobile-nav a { padding: 0.65rem 0.35rem; border-top: 1px solid var(--rule); }
  @media (max-width: 42rem) {
    .desktop-nav { display: none; }
    .mobile-nav { display: block; }
  }
</style>
