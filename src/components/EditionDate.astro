---
interface Props { date?: Date; }
const { date = new Date() } = Astro.props;
const label = new Intl.DateTimeFormat('en-US', {
  weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'Europe/Berlin',
}).format(date);
---

<p class="edition"><time datetime={date.toISOString().slice(0, 10)}>{label.toUpperCase()}</time> · INTERNET EDITION</p>

<style>
  .edition { margin: 0.75rem 0 1.05rem; color: var(--muted); font-size: 0.65rem; font-weight: 800; letter-spacing: 0.14em; }
</style>
