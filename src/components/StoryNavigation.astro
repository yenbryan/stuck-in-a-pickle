---
import type { Story } from '../types/story';
interface Props { previous?: Story; next?: Story; }
const { previous, next } = Astro.props;
---

<nav class="story-navigation" aria-label="Comic navigation">
  <div>{previous && <><span>← Previous pickle</span><a href={`/comic/${previous.slug}`}>{previous.title}</a></>}</div>
  <a class="random" href="/random"><span aria-hidden="true">↝</span> Surprise me</a>
  <div class="next">{next && <><span>Next pickle →</span><a href={`/comic/${next.slug}`}>{next.title}</a></>}</div>
</nav>

<style>
  .story-navigation { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1.5rem; margin-block: 3.5rem; padding-block: 1.4rem; border-block: 3px double var(--ink); }
  .story-navigation div { min-width: 0; }
  .story-navigation span { display: block; margin-bottom: 0.4rem; color: var(--muted); font-size: 0.62rem; font-weight: 800; letter-spacing: 0.11em; text-transform: uppercase; }
  .story-navigation div a { display: block; overflow: hidden; font-family: var(--serif); font-size: 1.05rem; font-weight: 750; line-height: 1.25; text-overflow: ellipsis; }
  .next { text-align: right; }
  .random { align-self: center; padding: 0.65rem 0.9rem; border: 1px solid var(--ink); background: var(--pickle-pale); font-size: 0.72rem; font-weight: 850; text-decoration: none; text-transform: uppercase; }
  .random:hover { background: var(--pickle); color: #fff; }
  @media (max-width: 42rem) {
    .story-navigation { grid-template-columns: 1fr 1fr; }
    .random { grid-column: 1 / -1; grid-row: 1; justify-self: center; }
  }
</style>
