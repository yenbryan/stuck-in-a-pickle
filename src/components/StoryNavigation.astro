---
import { Image } from 'astro:assets';
import type { Story } from '../types/story';
import { getComicAsset } from '../utils/stories';

/**
 * Previous / next, with artwork. On a comic site, a text-only "next" link is
 * the weakest possible invitation to read another one.
 */
interface Props {
  previous?: Story;
  next?: Story;
}

const { previous, next } = Astro.props;
const previousArt = previous ? getComicAsset(previous) : undefined;
const nextArt = next ? getComicAsset(next) : undefined;
---

<nav class="story-nav" aria-label="More comics">
  <div class="story-nav__slot">
    {previous && (
      <a class="story-nav__link" href={`/comic/${previous.slug}`}>
        {previousArt && (
          <span class:list={['story-nav__thumb', { 'story-nav__thumb--panoramic': previous.comicLayout === 'panoramic' }]}>
            <Image src={previousArt} alt="" widths={[144, 216]} sizes="72px" loading="lazy" decoding="async" />
          </span>
        )}
        <span class="story-nav__copy">
          <span class="story-nav__kicker"><span aria-hidden="true">&larr;</span> Previous</span>
          <span class="title-sm">{previous.title}</span>
        </span>
      </a>
    )}
  </div>

  <a class="button button--quiet story-nav__dice" href="/random">Random pickle</a>

  <div class="story-nav__slot story-nav__slot--next">
    {next && (
      <a class="story-nav__link" href={`/comic/${next.slug}`}>
        <span class="story-nav__copy">
          <span class="story-nav__kicker">Next <span aria-hidden="true">&rarr;</span></span>
          <span class="title-sm">{next.title}</span>
        </span>
        {nextArt && (
          <span class:list={['story-nav__thumb', { 'story-nav__thumb--panoramic': next.comicLayout === 'panoramic' }]}>
            <Image src={nextArt} alt="" widths={[144, 216]} sizes="72px" loading="lazy" decoding="async" />
          </span>
        )}
      </a>
    )}
  </div>
</nav>

<style>
  .story-nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    margin-top: var(--s-18);
    padding-top: var(--s-6);
    border-top: 1px solid var(--hair-strong);
  }

  .story-nav__slot {
    min-width: 0;
  }

  .story-nav__link {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
    text-decoration: none;
  }

  .story-nav__slot--next .story-nav__link {
    grid-template-columns: minmax(0, 1fr) 4.5rem;
    text-align: right;
  }

  /* Too small for the whole comic to survive, so these crop to panel one. */
  .story-nav__thumb {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .story-nav__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }

  .story-nav__kicker {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--ink-faint);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .story-nav__link:hover .title-sm {
    text-decoration: underline;
    text-decoration-thickness: 0.07em;
    text-underline-offset: 0.14em;
  }

  .story-nav__dice {
    justify-self: center;
  }

  @media (max-width: 52rem) {
    .story-nav {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .story-nav__slot:empty {
      display: none;
    }

    .story-nav__slot--next .story-nav__link {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      text-align: left;
    }

    .story-nav__slot--next .story-nav__thumb {
      order: -1;
    }

    .story-nav__dice {
      justify-self: start;
      order: 3;
    }
  }
</style>
