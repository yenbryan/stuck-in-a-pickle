---
import type { Story } from '../types/story';
import StoryCard from './StoryCard.astro';

interface Props {
  stories: Story[];
}

const { stories } = Astro.props;
---

{stories.length > 0 && (
  <section class="related" aria-labelledby="related-title">
    <div class="section-head">
      <h2 class="label" id="related-title">More nonsense</h2>
      <a class="section-head__aside" href="/archive">The whole archive <span aria-hidden="true">&rarr;</span></a>
    </div>
    <div class="related__grid">
      {stories.map((story) => <StoryCard story={story} variant="related" showDate={false} />)}
    </div>
  </section>
)}

<style>
  .related {
    margin-top: var(--s-28);
  }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2rem);
    align-items: start;
  }

  @media (max-width: 52rem) {
    .related__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 34rem) {
    .related__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
