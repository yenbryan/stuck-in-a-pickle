  <div>
    <p class="eyebrow">Occasional correspondence</p>
    <h2 id="newsletter-title">Get the nonsense delivered.</h2>
    <p>A few comics. No 47-email onboarding sequence. No growth-hacking your relationship with cucumbers.</p>
  </div>
  <form action="#newsletter-note" method="get">
    <label for="newsletter-email">Your email address</label>
    <div class="field-row"><input id="newsletter-email" name="email" type="email" autocomplete="email" placeholder="you@probably.email" required /><button type="submit">Put me on the list</button></div>
