---
import { categorySlug } from '../utils/stories';

interface Props {
  category: string;
  linked?: boolean;
}

const { category, linked = true } = Astro.props;
---

{linked ? (
  <a class="category-tag" href={`/category/${categorySlug(category)}`}>{category}</a>
) : (
  <span class="category-tag">{category}</span>
)}

<style>
  /* Categories are told apart by the word, not by a colour or a bullet. */
  .category-tag {
    display: inline-block;
    color: var(--pickle);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.145em;
    text-decoration: none;
    text-transform: uppercase;
  }

  a.category-tag:hover {
    color: var(--pickle-deep);
    text-decoration: underline;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.28em;
  }
</style>
