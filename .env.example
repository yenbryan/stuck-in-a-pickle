# Production origin, used for canonical URLs, RSS, robots.txt and the sitemap.
SITE_URL="https://stuckinapickle.com"

# Newsletter. Leave unset and the signup box honestly says it is not connected.
# Set it and the form posts straight to your provider — no JavaScript needed.
#
#   Buttondown   https://buttondown.com/api/emails/embed-subscribe/YOUR_USERNAME
#   Kit          https://app.kit.com/forms/YOUR_FORM_ID/subscriptions   (field: email_address)
#   MailerLite   the POST URL from the provider's embedded-form snippet
#
# PUBLIC_NEWSLETTER_ACTION="https://buttondown.com/api/emails/embed-subscribe/stuckinapickle"
# PUBLIC_NEWSLETTER_FIELD="email"
